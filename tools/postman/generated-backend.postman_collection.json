{
  "info": {
    "name": "Generated backend - course store CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Functional verification of a backend generated by the diagrammer. Run it against a generated destination whose PostgreSQL has been migrated by the generated Flyway migration. Every request is written so it can be run by hand in the Postman GUI or read as a script of the product's contract."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:19001" },
    { "key": "customerId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "missingId", "value": "00000000-0000-0000-0000-000000000000" }
  ],
  "item": [
    {
      "name": "01 health is UP",
      "request": { "method": "GET", "url": "{{baseUrl}}/actuator/health" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.test('status UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
      ] } }]
    },
    {
      "name": "02 list customers (empty)",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/customer" },
      "event": [{ "listen": "test", "script": { "exec": [ "pm.test('200', () => pm.response.to.have.status(200));" ] } }]
    },
    {
      "name": "03 create parent customer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/customer",
        "body": { "mode": "raw", "raw": "{\n  \"displayName\": \"Borges\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('201 created', () => pm.response.to.have.status(201));",
        "const body = pm.response.json();",
        "pm.expect(body.id, 'the created customer must carry its id').to.be.a('string');",
        "pm.collectionVariables.set('customerId', body.id);"
      ] } }]
    },
    {
      "name": "04 create child order referencing the customer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/order",
        "body": { "mode": "raw", "raw": "{\n  \"orderNumber\": \"Ficciones\",\n  \"customerId\": \"{{customerId}}\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('201 created', () => pm.response.to.have.status(201));",
        "const body = pm.response.json();",
        "pm.expect(body.customerId, 'the foreign key must come back RESOLVED, not null').to.eql(pm.collectionVariables.get('customerId'));",
        "pm.collectionVariables.set('orderId', body.id);"
      ] } }]
    },
    {
      "name": "05 read the order back by id",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/order/{{orderId}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.test('the foreign key persisted on re-read', () => pm.expect(pm.response.json().customerId).to.eql(pm.collectionVariables.get('customerId')));"
      ] } }]
    },
    {
      "name": "06 list both resources",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/order" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.test('the list is not empty', () => pm.expect(pm.response.json().length).to.be.above(0));"
      ] } }]
    },
    {
      "name": "07 a missing related id is a 400, never a 500",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/order",
        "body": { "mode": "raw", "raw": "{\n  \"orderNumber\": \"Ghost\",\n  \"customerId\": \"{{missingId}}\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('400', () => pm.response.to.have.status(400));",
        "pm.test('not a 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
        "pm.test('the code names the cause', () => pm.expect(pm.response.json().code).to.eql('INVALID_REFERENCE'));"
      ] } }]
    },
    {
      "name": "08 an unknown id is a 404",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/order/{{missingId}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('404', () => pm.response.to.have.status(404));",
        "pm.test('the code names the cause', () => pm.expect(pm.response.json().code).to.eql('NOT_FOUND'));"
      ] } }]
    }
  ]
}
